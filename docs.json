{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Calibri",
  "colors": {
    "primary": "#16305E",
    "light": "#5A8AE6",
    "dark": "#5A8AE6"
  },
  "fonts": {
    "family": "Manrope"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "background": {
    "color": {
      "light": "#FBFBF9",
      "dark": "#0A142E"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "getting-started/overview",
              "how-prediction-markets-work",
              "account-kyc",
              "wallet-deposits",
              "trading-placing-orders"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/core-concepts",
              "concepts/recurring-markets",
              "concepts/resolution-sources",
              "concepts/fees",
              "concepts/rewards",
              "rewards-referral-program"
            ]
          },
          {
            "group": "Self-Custody",
            "pages": [
              "non-custodial/overview",
              "non-custodial/wallets",
              "non-custodial/balances",
              "non-custodial/the-safe",
              "non-custodial/signed-orders",
              "non-custodial/session-keys",
              "non-custodial/redeeming-winnings",
              "non-custodial/resolution"
            ]
          },
          {
            "group": "Smart Contracts",
            "pages": [
              "smart-contracts/overview",
              "smart-contracts/deployed-addresses"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "terms-of-use",
              "privacy-policy"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors",
              "api-reference/rate-limits"
            ]
          },
          {
            "group": "Streaming",
            "pages": [
              "api-reference/websockets"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "/api-reference/openapi/calibri.yaml",
              "directory": "api-reference/endpoints"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://status.calibri.io",
          "icon": "heart"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://support.calibri.io/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start Trading",
      "href": "https://calibri.io"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Calibri",
        "items": [
          {
            "label": "Terms of use",
            "href": "https://calibri.io/hub/terms-of-use"
          },
          {
            "label": "Privacy policy",
            "href": "https://calibri.io/hub/privacy-policy"
          }
        ]
      }
    ]
  }
}
