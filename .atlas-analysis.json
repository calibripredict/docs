  "keyFeatures": [
    "Central Limit Order Book (CLOB) for peer-to-peer binary market trading",
    "Real-time WebSocket streams for order book, price, and trade events",
    "GTC, GTD, FOK, FAK, and Post-Only order types",
    "Fully collateralized outcome tokens (ERC-1155) with split/merge/redeem",
    "Multi-outcome negative risk markets for mutually exclusive events",
    "UMA Optimistic Oracle for decentralized market resolution",
    "TypeScript and Python SDKs",
    "Gasless transaction relayer for seamless wallet operations",
    "Maker/taker liquidity rewards and builder program",
    "REST APIs for market discovery, live pricing, and trade history"
  ],
  "publicApiSurface": [
    "GET /markets — list and filter markets",
    "GET /markets/{id} — fetch a single market",
    "GET /markets/{id}/prices-history — historical price data",
    "GET /book?token_id={id} — order book snapshot",
    "GET /price?token_id={id}&side={side} — best market price",
    "GET /midpoint?token_id={id} — midpoint price",
    "GET /spread?token_id={id} — bid-ask spread",
    "GET /last-trade-price?token_id={id} — last trade price",
    "POST /order — place a new order",
    "POST /orders — batch place orders (up to 15)",
    "DELETE /order/{id} — cancel a single order",
    "DELETE /orders/all — cancel all open orders",
    "GET /data/orders — list open orders",
    "GET /data/trades — list trades",
    "POST /auth/api-key — create API credentials (L1 wallet signature)",
    "GET /auth/derive-api-key — derive existing credentials",
    "GET /balances — asset balances",
    "GET /positions/{address} — current positions",
    "GET /rewards/earnings/{address}/{date} — liquidity reward earnings",
    "WSS /ws/market — public market data WebSocket",
    "WSS /ws/user — authenticated user order/trade WebSocket"
  ]
}
